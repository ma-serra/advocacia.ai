{
  "name": "advocacia.ai",
  "version": "1.0.0",
  "description": "Landing page completa para captação de leads jurídicos com Inteligência Artificial integrada",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
